export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 1.75 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
