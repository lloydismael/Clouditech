---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  id?: string;
  center?: boolean;
}
const { eyebrow, title, intro, id, center = false } = Astro.props;
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center']} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-4 text-3xl font-bold sm:text-4xl lg:text-[2.75rem]">{title}</h2>
  {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
</div>
