---
import Icon from './Icon.astro';
import { services, journey } from '../data/services';
import { projects } from '../data/projects';
import { bookingHref } from '../data/site';
---

<div class="services-explorer mt-12 grid gap-6 lg:grid-cols-[minmax(0,20rem)_1fr]" data-reveal>
  <div role="tablist" aria-label="Services" aria-orientation="vertical" class="tablist -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0 lg:pb-0">
    {services.map((s, i) => (
      <button
        role="tab"
        type="button"
        id={`tab-${s.slug}`}
        aria-controls={`panel-${s.slug}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="tab group icon-anim flex min-h-14 shrink-0 items-center gap-3 rounded-2xl border border-transparent px-4 py-3 text-left transition-[background-color,border-color,box-shadow] duration-300"
      >
        <span class="icon-tile !size-10 shrink-0"><Icon name={s.icon} /></span>
        <span class="whitespace-nowrap font-display font-semibold text-ink lg:whitespace-normal">{s.title}</span>
        <Icon name="arrowRight" class="tab-arrow ml-auto hidden size-4 text-primary lg:block" />
      </button>
    ))}
  </div>

  <div class="card relative min-h-[26rem] !p-0">
    {services.map((s, i) => {
      const related = projects.find((p) => p.slug === s.relatedProject);
      return (
        <section
          role="tabpanel"
          id={`panel-${s.slug}`}
          aria-labelledby={`tab-${s.slug}`}
          tabindex="0"
          hidden={i !== 0}
          class="panel grid gap-8 p-7 sm:p-10 md:grid-cols-[1.2fr_1fr]"
        >
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-cyan-text">{s.title}</p>
            <h3 class="mt-3 text-2xl font-bold sm:text-3xl">{s.headline}</h3>
            <p class="mt-4 text-muted">{s.summary}</p>
            <ul class="mt-6 grid gap-3">
              {s.outcomes.map((o) => (
                <li class="flex gap-3 text-[0.95rem]">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-cyan/15 text-cyan-text"><Icon name="check" class="size-3.5" strokeWidth={2.5} /></span>
                  {o}
                </li>
              ))}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={`/services/${s.slug}/`} class="btn btn-primary">Explore {s.short} <Icon name="arrowRight" /></a>
              {related ? (
                <a href={`/projects/${related.slug}/`} class="btn btn-secondary">See {related.title}</a>
              ) : (
                <a href={bookingHref} class="btn btn-secondary">Talk to an engineer</a>
              )}
            </div>
          </div>
          <div class="rounded-2xl border border-line bg-white/70 p-6">
            <h4 class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">What you get</h4>
            <ul class="mt-4 grid gap-2.5 text-sm">
              {s.deliverables.map((d) => <li class="flex items-center gap-2.5"><span class="size-1.5 rounded-full bg-primary"></span>{d}</li>)}
            </ul>
            <h4 class="mt-6 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">Typical stack</h4>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {s.stack.map((t) => <li class="badge">{t}</li>)}
            </ul>
          </div>
        </section>
      );
    })}
  </div>
</div>

<ol class="journey mt-10 grid grid-cols-5 gap-2" aria-label="Cloud journey">
  {journey.map((stage, i) => {
    const svc = services.find((s) => s.stage === stage);
    return (
      <li class="journey-step relative text-center" data-reveal={String(i)} data-stage-for={svc?.slug}>
        <span class="journey-dot mx-auto grid size-9 place-items-center rounded-full border-2 border-line bg-white font-mono text-xs font-bold text-muted transition-all duration-300">{i + 1}</span>
        <span class="mt-2 block text-xs font-semibold text-muted sm:text-sm">{stage}</span>
      </li>
    );
  })}
</ol>

<style>
  .tab:hover { background: rgb(255 255 255 / 0.6); }
  .tab[aria-selected='true'] {
    background: var(--glass-bg);
    border-color: var(--glass-border);
    box-shadow: var(--shadow-glass);
  }
  .tab-arrow { opacity: 0; transform: translateX(-6px); transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out-expo); }
  .tab[aria-selected='true'] .tab-arrow { opacity: 1; transform: none; }
  .tablist { scrollbar-width: none; }

  .panel:not([hidden]) { animation: panel-in var(--dur-base) var(--ease-out-expo); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } }

  .journey-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.125rem;
    left: calc(50% + 1.375rem);
    right: calc(-50% + 1.375rem);
    height: 2px;
    background: var(--color-line);
  }
  .journey-step.is-active .journey-dot {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 0 0 6px rgb(23 105 224 / 0.15);
  }
  .journey-step.is-active > span:last-child { color: var(--color-ink); }
</style>

<script>
  function initExplorer() {
    document.querySelectorAll<HTMLElement>('.services-explorer').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const steps = document.querySelectorAll<HTMLElement>('.journey-step');

      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls')!);
          if (panel) panel.hidden = !on;
        });
        const slug = tab.id.replace('tab-', '');
        steps.forEach((s) => s.classList.toggle('is-active', s.dataset.stageFor === slug));
        if (focus) tab.focus();
        tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
          if (e.key in keys) {
            e.preventDefault();
            select(tabs[(i + keys[e.key] + tabs.length) % tabs.length], true);
          } else if (e.key === 'Home') {
            e.preventDefault();
            select(tabs[0], true);
          } else if (e.key === 'End') {
            e.preventDefault();
            select(tabs[tabs.length - 1], true);
          }
        });
      });

      const current = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (current) steps.forEach((s) => s.classList.toggle('is-active', s.dataset.stageFor === current.id.replace('tab-', '')));
    });
  }
  document.addEventListener('astro:page-load', initExplorer);
</script>
