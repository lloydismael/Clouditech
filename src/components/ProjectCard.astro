---
import Icon from './Icon.astro';
import ProjectPreview from './ProjectPreview.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { project: p, index = 0, headingLevel: H = 'h3' } = Astro.props;
---

<div class="h-full min-w-0" data-reveal={String(index)} data-services={p.services.join(' ')} data-search={`${p.title} ${p.category} ${p.outcome} ${p.stack.join(' ')}`.toLowerCase()}>
<article
  class="project-card card group flex h-full flex-col overflow-hidden !p-0"
  data-tilt
  style={`--accent:${p.accent}`}
>
  <ProjectPreview project={p} />
  <div class="flex flex-1 flex-col p-6">
    <span class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-muted">{p.category}</span>
    <span class="chip-metric self-start"><Icon name="check" class="size-3.5" />{p.highlight}</span>
    <H class="mt-4 text-xl font-bold">
      <a href={`/projects/${p.slug}/`} class="text-ink no-underline hover:text-primary" transition:name={`project-${p.slug}`}>{p.title}</a>
    </H>
    <p class="mt-2 flex-1 text-[0.95rem] text-muted">{p.outcome}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tech stack">
      {p.stack.slice(0, 4).map((t) => <li class="badge">{t}</li>)}
    </ul>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 border-t border-line pt-3">
      <a href={`/projects/${p.slug}/`} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-primary no-underline" aria-label={`Read the ${p.title} case study`}>
        Read case study <Icon name="arrowRight" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
      {p.url && (
        <a
          href={p.url}
          class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-muted no-underline transition-colors hover:text-primary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visit the live ${p.title} site (opens in a new tab)`}
        >
          Visit live site <Icon name="arrowUpRight" class="size-4" />
        </a>
      )}
    </div>
  </div>
</article>
</div>

<style>
  .project-card:focus-within { box-shadow: var(--shadow-lift); }
</style>
