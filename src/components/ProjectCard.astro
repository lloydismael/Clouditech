---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { project: p, index = 0, headingLevel: H = 'h3' } = Astro.props;
---

<div class="h-full" data-reveal={String(index)} data-services={p.services.join(' ')} data-search={`${p.title} ${p.category} ${p.outcome} ${p.stack.join(' ')}`.toLowerCase()}>
<article
  class="project-card card group flex h-full flex-col overflow-hidden !p-0"
  data-tilt
  style={`--accent:${p.accent}`}
>
  <div class="project-cover relative h-40 overflow-hidden" aria-hidden="true">
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 160" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id={`g-${p.slug}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={p.accent} stop-opacity="0.9" />
          <stop offset="1" stop-color="#0e1e36" />
        </linearGradient>
      </defs>
      <rect width="400" height="160" fill={`url(#g-${p.slug})`} />
      <g stroke="#fff" stroke-opacity="0.25" fill="none">
        <path d="M40 120 C 120 40, 200 140, 280 60 S 380 80, 400 40" />
        <path d="M0 80 C 80 120, 160 20, 260 100 S 360 140, 400 110" />
      </g>
      <g fill="#fff">
        <circle cx="40" cy="120" r="4" fill-opacity="0.9" />
        <circle cx="280" cy="60" r="4" fill-opacity="0.9" />
        <circle cx="260" cy="100" r="3" fill-opacity="0.6" />
        <circle cx="160" cy="62" r="3" fill-opacity="0.6" />
      </g>
    </svg>
    <span class="absolute left-5 top-5 rounded-full bg-white/90 px-3 py-1 font-mono text-[0.7rem] font-semibold text-ink">{p.category}</span>
    <span class="glare pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <span class="chip-metric self-start"><Icon name="check" class="size-3.5" />{p.highlight}</span>
    <H class="mt-4 text-xl font-bold">
      <a href={`/projects/${p.slug}/`} class="text-ink no-underline after:absolute after:inset-0 after:content-['']" transition:name={`project-${p.slug}`}>{p.title}</a>
    </H>
    <p class="mt-2 flex-1 text-[0.95rem] text-muted">{p.outcome}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tech stack">
      {p.stack.slice(0, 4).map((t) => <li class="badge">{t}</li>)}
    </ul>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
      Read case study <Icon name="arrowRight" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
    </span>
  </div>
</article>
</div>

<style>
  .glare {
    background: radial-gradient(30rem circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.22), transparent 40%);
  }
  .project-card:focus-within { box-shadow: var(--shadow-lift); }
  .project-card svg { transition: transform var(--dur-slow) var(--ease-out-expo); }
  .project-card:hover .project-cover svg { transform: scale(1.05); }
</style>
