---
// Draggable before/after comparison. A native range input drives the split, so it works with keyboard and screen readers.
interface Props {
  before: string[];
  after: string[];
  label: string;
}
const { before, after, label } = Astro.props;
const id = `ba-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class="ba relative overflow-hidden rounded-[var(--radius-card)] border border-line" style="--pos:50%">
  <div class="ba-pane ba-after grid content-center gap-3 bg-gradient-to-br from-primary to-[#0b5f8f] p-8 text-white sm:p-12" aria-hidden="true">
    <p class="text-right font-mono text-xs font-semibold uppercase tracking-[0.14em] text-white/80">After</p>
    <ul class="grid gap-3 justify-self-end text-right">
      {after.map((a) => <li class="font-display text-lg font-semibold sm:text-xl">{a}</li>)}
    </ul>
  </div>
  <div class="ba-pane ba-before absolute inset-0 grid content-center gap-3 bg-[#e9eef4] p-8 text-ink sm:p-12" aria-hidden="true">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">Before</p>
    <ul class="grid gap-3">
      {before.map((b) => <li class="font-display text-lg font-semibold text-muted sm:text-xl">{b}</li>)}
    </ul>
  </div>
  <span class="ba-handle pointer-events-none absolute inset-y-0 w-0.5 bg-white shadow-[0_0_0_1px_rgb(14_30_54/0.15)]" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-primary shadow-lg">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l-6-6 6-6M15 6l6 6-6 6" /></svg>
    </span>
  </span>
  <label class="sr-only" for={id}>Compare before and after: {label}</label>
  <input id={id} type="range" min="0" max="100" value="50" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
  <div class="sr-only">
    <p>Before:</p><ul>{before.map((b) => <li>{b}</li>)}</ul>
    <p>After:</p><ul>{after.map((a) => <li>{a}</li>)}</ul>
  </div>
</div>

<style>
  .ba-after { min-height: 18rem; }
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-handle { left: var(--pos); }
  .ba:has(.ba-range:focus-visible) { outline: 3px solid var(--color-primary); outline-offset: 3px; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.ba').forEach((root) => {
      const range = root.querySelector<HTMLInputElement>('.ba-range');
      range?.addEventListener('input', () => root.style.setProperty('--pos', `${range.value}%`));
    });
  });
</script>
