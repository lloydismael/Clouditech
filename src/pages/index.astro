---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServicesExplorer from '../components/ServicesExplorer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { bookingHref, stats, technologies, testimonials } from '../data/site';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured).slice(0, 4);
const headline = ['Your', 'Azure,', 'running', 'smoothly,'];

const reasons = [
  { icon: 'user', title: 'Founder-led delivery', text: 'You work directly with the engineer who designs and builds your platform. No hand-offs, no account-manager layer.' },
  { icon: 'code', title: 'Everything as code', text: 'Infrastructure, pipelines, and policies are versioned and documented, so your environment is never a black box.' },
  { icon: 'lock', title: 'Security by default', text: 'Identity, network boundaries, and guardrails are designed in from day one, not bolted on after an incident.' },
  { icon: 'gauge', title: 'Cost-aware operations', text: 'Monthly reviews keep spend visible and right-sized as your workloads and team grow.' },
] as const;

const process = [
  { title: 'Assess', text: 'Review your environment, priorities, risks, and constraints.' },
  { title: 'Design', text: 'Agree the target architecture, security approach, and cost model.' },
  { title: 'Build', text: 'Deliver in tested increments with automation and monitoring included.' },
  { title: 'Operate', text: 'Monitor, maintain, and improve as your needs evolve.' },
];
---

<Layout
  title="Clouditech | Azure Managed Services, Migration & DevOps in the Philippines"
  description="Clouditech builds, automates, and manages secure Microsoft Azure platforms for growing businesses: cloud migration, Azure DevOps, managed cloud operations, and AI automation."
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Clouditech', url: 'https://clouditechsolution.com' }]}
>
  <!-- Hero -->
  <section class="bg-aurora relative isolate overflow-hidden pb-20 pt-32 sm:pb-28 sm:pt-40" aria-labelledby="hero-title">
    <HeroNetwork />
    <div class="wrap grid items-center gap-14 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="eyebrow hero-in" style="--d:0">Managed Microsoft Azure services</p>
        <h1 id="hero-title" class="mt-6 text-[2.6rem] font-extrabold leading-[1.05] sm:text-6xl lg:text-[4.25rem]">
          {headline.map((word, i) => <span class="hero-word mr-[0.25em]" style={`--d:${i + 1}`}>{word}</span>)}
          <span class="hero-word text-gradient" style="--d:5">secure, and on budget.</span>
        </h1>
        <p class="hero-in mt-6 max-w-xl text-lg text-muted sm:text-xl" style="--d:6">
          Clouditech builds, automates, and operates Azure for growing businesses, so your team can ship with confidence instead of firefighting infrastructure.
        </p>
        <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:7">
          <a href={bookingHref} class="btn btn-primary !min-h-12 !px-6 !text-base">Book a free Azure assessment <Icon name="arrowRight" /></a>
          <a href="/projects/" class="btn btn-secondary !min-h-12 !px-6 !text-base">See our projects</a>
        </div>
        <ul class="hero-in mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" style="--d:8" aria-label="Highlights">
          <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-cyan-text" strokeWidth={2.5} />Founder-led engineering</li>
          <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-cyan-text" strokeWidth={2.5} />Infrastructure as code</li>
          <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-cyan-text" strokeWidth={2.5} />Based in Makati, serving remote clients</li>
        </ul>
      </div>

      <aside class="hero-in hero-float card !p-7" style="--d:6" aria-label="Managed service overview">
        <div class="flex items-center justify-between">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">Platform status</p>
          <span class="inline-flex items-center gap-2 rounded-full bg-cyan/10 px-3 py-1 text-xs font-semibold text-cyan-text"><span class="pulse size-2 rounded-full bg-cyan"></span>Operational</span>
        </div>
        <p class="mt-5 font-display text-xl font-bold leading-snug">One accountable partner across your cloud lifecycle.</p>
        <ul class="mt-6 grid gap-3">
          {[
            ['Platform', 'Microsoft Azure', 'layers'],
            ['Delivery', 'Infrastructure as code', 'code'],
            ['Operations', 'Monitoring & optimization', 'gauge'],
            ['Security', 'Identity-first guardrails', 'lock'],
          ].map(([k, v, icon]) => (
            <li class="flex items-center gap-3 rounded-xl border border-line/80 bg-white/70 px-4 py-3">
              <span class="icon-tile !size-9 !rounded-xl"><Icon name={icon as 'layers'} class="!size-[1.1rem]" /></span>
              <span class="text-sm text-muted">{k}</span>
              <strong class="ml-auto text-right text-sm font-semibold">{v}</strong>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section-pad" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHeading id="services-title" eyebrow="What we do best" title="Everything your Azure platform needs, from first migration to daily operations." intro="Pick a service to see the outcomes, deliverables, and typical stack." />
      <ServicesExplorer />
    </div>
  </section>

  <!-- Featured projects -->
  <section id="projects" class="section-pad relative bg-white/50" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading id="projects-title" eyebrow="Selected work" title="Work that solves real operating problems." intro="Each project starts with a real problem and ends with a platform the team can actually run." />
        <a href="/projects/" class="btn btn-secondary" data-reveal>View all projects <Icon name="arrowRight" /></a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Why Clouditech + stats -->
  <section id="why" class="section-pad" aria-labelledby="why-title">
    <div class="wrap">
      <SectionHeading id="why-title" eyebrow="Why Clouditech" title="Senior expertise, without the enterprise overhead." center />
      {stats.length > 0 && (
        <dl class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-3">
          {stats.map((s, i) => (
            <div class="card flex flex-col text-center" data-reveal={String(i)}>
              <dt class="order-2 mt-2 text-sm text-muted">{s.label}</dt>
              <dd class="font-display text-5xl font-extrabold tabular-nums text-gradient" data-count={s.value} data-suffix={s.suffix ?? ''}>{s.value}{s.suffix}</dd>
            </div>
          ))}
        </dl>
      )}
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r, i) => (
          <div data-reveal={String(i)}>
            <article class="card card-hover h-full">
              <span class="icon-tile"><Icon name={r.icon} /></span>
              <h3 class="mt-5 text-lg font-bold">{r.title}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">{r.text}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section id="process" class="section-pad bg-white/50" aria-labelledby="process-title">
    <div class="wrap">
      <SectionHeading id="process-title" eyebrow="How we work" title="A predictable path from assessment to operation." intro="Every engagement makes decisions visible, reduces delivery risk, and leaves your platform easier to run." />
      <ol class="process relative mt-14 grid gap-8 md:grid-cols-4 md:gap-6">
        <span class="process-line" data-reveal aria-hidden="true"></span>
        {process.map((step, i) => (
          <li class="relative max-md:grid max-md:grid-cols-[3rem_1fr] max-md:gap-x-5" data-reveal={String(i + 1)}>
            <span class="relative z-10 grid size-12 place-items-center rounded-full bg-primary font-mono text-sm font-bold text-white shadow-[0_0_0_8px_rgb(23_105_224/0.12)] max-md:row-span-2">0{i + 1}</span>
            <h3 class="text-xl font-bold max-md:self-end md:mt-5">{step.title}</h3>
            <p class="mt-2 text-muted max-md:col-start-2">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Technologies -->
  <section id="technology" class="section-pad !pb-12" aria-labelledby="tech-title">
    <div class="wrap">
      <SectionHeading id="tech-title" eyebrow="Technology" title="Built on platforms you already trust." center />
    </div>
    <div class="marquee mt-12 overflow-hidden" data-reveal>
      <ul class="marquee-track flex w-max gap-4">
        {[...technologies, ...technologies].map((t, i) => (
          <li data-clone={i >= technologies.length ? '' : undefined} aria-hidden={i >= technologies.length ? 'true' : undefined} class="whitespace-nowrap rounded-full border border-line bg-white/80 px-6 py-3 font-display text-base font-semibold text-muted transition-colors hover:border-primary/30 hover:text-primary">{t}</li>
        ))}
      </ul>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section id="testimonials" class="section-pad" aria-labelledby="testimonials-title">
      <div class="wrap">
        <SectionHeading id="testimonials-title" eyebrow="Client voices" title="What teams say after working with us." center />
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t, i) => (
            <figure class="card" data-reveal={String(i)}>
              <Icon name="quote" class="size-8 text-primary/40" />
              <blockquote class="mt-4 text-ink">{t.quote}</blockquote>
              <figcaption class="mt-6 text-sm"><strong class="block">{t.name}</strong><span class="text-muted">{t.role}, {t.company}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Layout>

<style>
  .hero-word, .hero-in {
    display: inline-block;
    animation: hero-rise var(--dur-hero) var(--ease-out-expo) both;
    animation-delay: calc(var(--d) * 80ms);
  }
  .hero-in { display: block; }
  .hero-in.flex { display: flex; }
  .hero-in.eyebrow { display: inline-flex; }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(18px); } }

  .hero-float { animation: hero-rise var(--dur-hero) var(--ease-out-expo) both, float 6s ease-in-out 1.2s infinite; animation-delay: 480ms, 1.2s; }
  @keyframes float { 50% { translate: 0 -8px; } }

  .pulse { box-shadow: 0 0 0 0 rgb(11 143 131 / 0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgb(11 143 131 / 0); } 100% { box-shadow: 0 0 0 0 rgb(11 143 131 / 0); } }

  .process-line {
    position: absolute;
    left: 1.5rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    background: linear-gradient(180deg, var(--color-primary), var(--color-cyan));
    transform-origin: top;
  }
  @media (min-width: 768px) {
    .process-line { left: 1.5rem; right: 1.5rem; top: 1.5rem; bottom: auto; width: auto; height: 2px; background: linear-gradient(90deg, var(--color-primary), var(--color-cyan)); transform-origin: left; }
  }
  :global(.js) .process-line[data-reveal] { opacity: 1; transform: scaleY(0); transition: transform 1.4s var(--ease-in-out-smooth); }
  :global(.js) .process-line[data-reveal].is-visible { transform: none; }
  @media (min-width: 768px) {
    :global(.js) .process-line[data-reveal] { transform: scaleX(0); }
    :global(.js) .process-line[data-reveal].is-visible { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-float { animation: none; }
    :global(.js) .process-line[data-reveal] { transform: none; }
  }
</style>
