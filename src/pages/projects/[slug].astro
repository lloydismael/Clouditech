---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, type Project } from '../../data/projects';
import { services } from '../../data/services';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project: p, next } = Astro.props;
const related = services.filter((s) => p.services.includes(s.slug));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: p.title,
    description: p.outcome,
    creator: { '@type': 'Organization', name: 'Clouditech Information Technology Solutions' },
    keywords: p.stack.join(', '),
    ...(p.url ? { url: p.url } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Projects', item: 'https://clouditechsolution.com/projects/' },
      { '@type': 'ListItem', position: 2, name: p.title, item: `https://clouditechsolution.com/projects/${p.slug}/` },
    ],
  },
];
---

<Layout title={`${p.title} Case Study | Clouditech`} description={`${p.title}: ${p.outcome}`} jsonLd={jsonLd}>
  <PageHeader eyebrow={p.category} title={p.title} intro={p.outcome}>
    <a slot="before" href="/projects/" class="inline-flex items-center gap-2 text-sm font-semibold text-muted no-underline hover:text-primary"><Icon name="arrowLeft" class="size-4" />All projects</a>
    <span slot="title" transition:name={`project-${p.slug}`}>{p.title}</span>
    <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 text-sm">
      <div><dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Services</dt><dd class="mt-1 font-semibold">{related.map((s) => s.title).join(' · ')}</dd></div>
      <div><dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Highlight</dt><dd class="mt-1 font-semibold">{p.highlight}</dd></div>
    </dl>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">{p.stack.map((t) => <li class="badge">{t}</li>)}</ul>
    {p.url && (
      <a href={p.url} class="btn btn-primary mt-6" target="_blank" rel="noopener noreferrer" aria-label={`Visit the live ${p.title} site (opens in a new tab)`}>
        Visit live site <Icon name="arrowUpRight" class="size-4" />
      </a>
    )}
  </PageHeader>

  <article class="section-pad !pt-8">
    {p.image && (
      <section class="wrap mb-12" aria-labelledby="preview-title">
        <h2 id="preview-title" class="mb-5 text-2xl font-bold">Project preview</h2>
        <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-line shadow-lg">
          <ProjectPreview project={p} />
        </div>
      </section>
    )}
    <div class="wrap grid gap-6 lg:grid-cols-3">
      <section class="card" data-reveal="0" aria-labelledby="problem">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-[#b4472b]">01 · Problem</span>
        <h2 id="problem" class="mt-3 text-2xl font-bold">The challenge</h2>
        <p class="mt-4 text-muted">{p.problem}</p>
      </section>
      <section class="card" data-reveal="1" aria-labelledby="solution">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-primary">02 · Solution</span>
        <h2 id="solution" class="mt-3 text-2xl font-bold">What we built</h2>
        <ul class="prose-ct">{p.solution.map((s) => <li>{s}</li>)}</ul>
      </section>
      <section class="card" data-reveal="2" aria-labelledby="result">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-cyan-text">03 · Result</span>
        <h2 id="result" class="mt-3 text-2xl font-bold">What changed</h2>
        <ul class="prose-ct">{p.results.map((r) => <li>{r}</li>)}</ul>
      </section>
    </div>

    {p.metrics && p.metrics.length > 0 && (
      <div class="wrap mt-6">
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {p.metrics.map((m, i) => (
            <div class="card flex flex-col text-center" data-reveal={String(i)}>
              <dt class="order-2 mt-2 text-sm text-muted">{m.label}</dt>
              <dd class="font-display text-4xl font-extrabold tabular-nums text-gradient" data-count={m.value} data-prefix={m.prefix ?? ''} data-suffix={m.suffix ?? ''}>{m.prefix}{m.value}{m.suffix}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div class="wrap mt-16">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Before / after</p>
        <h2 class="mt-3 text-3xl font-bold">Drag to compare.</h2>
      </div>
      <div class="mt-8" data-reveal>
        <BeforeAfter before={p.before} after={p.after} label={p.title} />
      </div>
    </div>

    <nav class="wrap mt-16" aria-label="Next project">
      <a href={`/projects/${next.slug}/`} class="card card-hover group flex items-center justify-between gap-6 no-underline" data-reveal>
        <span>
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted">Next project</span>
          <span class="mt-2 block font-display text-2xl font-bold text-ink">{next.title}</span>
          <span class="mt-1 block text-muted">{next.outcome}</span>
        </span>
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-primary text-white transition-transform duration-300 group-hover:translate-x-1"><Icon name="arrowRight" /></span>
      </a>
    </nav>
  </article>

  <CtaBand title="Want results like these?" cta="Get results like these" />
</Layout>
